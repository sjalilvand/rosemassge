SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USER=admin
# رمز مدیر (حداقل ۱۲ نویسه). اگر خالی باشد، در اولین اجرا از صفحه ورود ساخته می‌شود
ADMIN_PASSWORD=
MIN_PASSWORD=12
PORT=8088
DATA_DIR=data
# روی HTTPS مقدار 1 بگذارید (برای ضبط پیام صوتی لازم است)
SECURE_COOKIE=0
# HTTPS اختیاری: 1 = گواهی خودامضا ساخته و روی همان پورت HTTPS سرو می‌شود
TLS_ENABLED=0
